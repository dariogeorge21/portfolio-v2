generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TimelineSide {
  left
  right
}

model PortfolioProfile {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code         String?  @db.VarChar(50)
  name         String?  @db.VarChar(255)
  location     String?  @db.VarChar(255)
  locationType String?  @map("location_type") @db.VarChar(100)
  website      String?
  role         String?  @db.VarChar(255)
  github       String?
  linkedin     String?
  email        String?  @db.VarChar(255)
  x            String?
  phone        String?  @db.VarChar(50)
  status       String?  @db.VarChar(255)
  statusLocation String? @map("status_location") @db.VarChar(255)
  imageLink    String?  @map("image_link")
  resume       String?
  buyMeACoffee String?  @map("buy_me_a_coffee")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("portfoliov2_profile")
}

model ContactContent {
  id      String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  topHead String? @map("top_head")
  subHead String? @map("sub_head")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("portfoliov2_contact_content")
}

model AboutLine {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lineOrder Int      @map("line_order")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([lineOrder])
  @@map("portfoliov2_about_lines")
}

model Headline {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  headline  String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @map("updated_at")

  tags      HeadlineTag[]

  @@map("portfoliov2_headline")
}

model HeadlineTag {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  headlineId String   @map("headline_id") @db.Uuid
  tag        String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")

  headline Headline @relation(fields: [headlineId], references: [id], onDelete: Cascade)

  @@index([headlineId])
  @@map("portfoliov2_headline_tags")
}

model Badge {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  label     String   @db.VarChar(255)
  sub       String?  @db.VarChar(255)
  icon      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("portfoliov2_badges")
}

model Project {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  priorityIndex Int          @map("priority_index")
  slug          String       @unique @db.VarChar(255)
  title         String       @db.VarChar(255)
  subtitle      String?
  category      String?      @db.VarChar(255)
  year          String?      @db.VarChar(10)
  image         String?
  role          String?      @db.VarChar(255)
  longDescription String?    @map("long_description")
  liveUrl       String?      @map("live_url")
  repoUrl       String?      @map("repo_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  tags ProjectTag[]

  @@index([priorityIndex])
  @@index([slug])
  @@map("portfoliov2_projects")
}

model ProjectTag {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  tag       String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("portfoliov2_project_tags")
}

model SkillGroup {
  id        String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  label     String  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  skills Skill[]

  @@map("portfoliov2_skill_groups")
}

model Skill {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  groupId   String?  @map("group_id") @db.Uuid
  name      String   @db.VarChar(255)
  level     Int?
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  group SkillGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("portfoliov2_skills")
}

model TimelineItem {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  year        String?      @db.VarChar(50)
  title       String?
  org         String?
  description String?
  side        TimelineSide?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("portfoliov2_timeline")
}

model Education {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  degree      String?  @db.VarChar(255)
  institution String?  @db.VarChar(255)
  location    String?  @db.VarChar(255)
  period      String?  @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  achievements EducationAchievement[]

  @@map("portfoliov2_education")
}

model EducationAchievement {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  educationId String   @map("education_id") @db.Uuid
  achievement String
  createdAt   DateTime @default(now()) @map("created_at")

  education Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@index([educationId])
  @@map("portfoliov2_education_achievements")
}

model Stat {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  value     String?  @db.VarChar(100)
  label     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("portfoliov2_stats")
}

model SocialLink {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  label     String?  @db.VarChar(100)
  handle    String?  @db.VarChar(255)
  href      String?
  icon      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("portfoliov2_social_links")
}

model CmsUser {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username     String   @unique @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  role         String?  @default("admin") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("portfoliov2_cms_users")
}
